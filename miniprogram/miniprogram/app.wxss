@import "./styles/tokens.wxss";

page {
  background: var(--color-surface-sunken);
  color: var(--color-text-primary);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: var(--text-base);
  line-height: var(--leading-normal);
}

.wrap { padding: var(--space-4) var(--space-4) 160px; }

/* 顶部上下文 */
.ctx {
  display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--space-4);
  padding: var(--space-3) var(--space-4);
  margin: 0 calc(var(--space-4) * -1) var(--space-4);
  background: var(--color-surface-card);
  border-bottom: 1px solid var(--color-border-default);
}
.ctx__field { display: flex; flex-direction: column; gap: var(--space-1); }
.ctx__label { font-size: var(--text-xs); color: var(--color-text-tertiary); }
.ctx__value { font-size: var(--text-sm); font-weight: var(--weight-medium); }
.ctx__picker {
  font-size: var(--text-sm); font-variant-numeric: tabular-nums;
  padding: var(--space-1) var(--space-2);
  border: 1px solid var(--color-border-default);
  border-radius: var(--radius-input);
}
.ctx__src { margin-left: auto; font-size: var(--text-xs); color: var(--color-text-tertiary); }

.hint { margin: 0 0 var(--space-4); font-size: var(--text-sm); color: var(--color-text-secondary); }

/* 码表单元 */
.unit {
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-2);
  background: var(--color-surface-card);
  border: 1px solid var(--color-border-default);
  border-radius: var(--radius-card);
}
.unit--warn { border-color: var(--color-feedback-warning-border); }
.unit__head { display: flex; align-items: baseline; gap: var(--space-2); margin-bottom: var(--space-2); }
.unit__name { font-size: var(--text-base); font-weight: var(--weight-semibold); }
.unit__meta { font-size: var(--text-xs); color: var(--color-text-tertiary); }
.unit__prev { font-size: var(--text-xs); color: var(--color-text-tertiary); font-variant-numeric: tabular-nums; margin-bottom: var(--space-2); }

.unit__grid { display: flex; gap: var(--space-3); }
.cell { flex: 1; display: flex; flex-direction: column; gap: var(--space-1); }
.cell__k { font-size: var(--text-xs); color: var(--color-text-tertiary); }
.cell__input {
  height: 44px; padding: 0 var(--space-3);
  font-size: var(--text-lg); font-variant-numeric: tabular-nums; text-align: right;
  background: var(--color-surface-card);
  border: 1px solid var(--color-border-default);
  border-radius: var(--radius-input);
}
.cell__delta { font-size: var(--text-xs); color: var(--color-text-secondary); font-variant-numeric: tabular-nums; min-height: 16px; }
.cell__delta--neg { color: var(--color-feedback-error-text); }

/* 告警 */
.banner {
  margin: var(--space-4) 0;
  padding: var(--space-3) var(--space-4);
  background: var(--color-feedback-warning-bg);
  border: 1px solid var(--color-feedback-warning-border);
  border-radius: var(--radius-card);
}
.banner__t { display: block; font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-feedback-warning-text); }
.banner__d { display: block; margin-top: var(--space-1); font-size: var(--text-xs); color: var(--color-feedback-warning-text); }

/* 底部动作条 */
.bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: var(--space-3) var(--space-4) calc(var(--space-3) + env(safe-area-inset-bottom));
  background: var(--color-surface-card);
  border-top: 1px solid var(--color-border-default);
}
.bar__hint { display: block; margin-top: var(--space-2); font-size: var(--text-xs); color: var(--color-text-secondary); text-align: center; }

.btn {
  display: flex; align-items: center; justify-content: center;
  height: 48px; font-size: var(--text-base); font-weight: var(--weight-medium);
  color: var(--color-text-on-action);
  background: var(--color-action-primary);
  border: none; border-radius: var(--radius-button);
}
.btn--ghost {
  color: var(--color-text-primary);
  background: var(--color-action-secondary);
  border: 1px solid var(--color-border-default);
}
.btn[disabled] { opacity: var(--opacity-disabled); }

/* 汇总带 */
.band {
  display: flex; flex-wrap: wrap;
  margin-bottom: var(--space-4);
  background: var(--color-border-default);
  border: 1px solid var(--color-border-default);
  border-radius: var(--radius-card);
  overflow: hidden;
}
.band__cell {
  flex: 1 1 50%; min-width: 45%;
  display: flex; flex-direction: column; gap: var(--space-1);
  padding: var(--space-3) var(--space-4);
  background: var(--color-surface-card);
}
.band__k { font-size: var(--text-xs); color: var(--color-text-tertiary); }
.band__v { font-size: var(--text-xl); font-weight: var(--weight-semibold); font-variant-numeric: tabular-nums; }
.band__v--lead { font-size: var(--text-3xl); }
.band__u { font-size: var(--text-xs); color: var(--color-text-tertiary); }

/* 核对列表 */
.row {
  display: flex; align-items: center; gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-2);
  background: var(--color-surface-card);
  border: 1px solid var(--color-border-default);
  border-radius: var(--radius-card);
}
.row__main { flex: 1; min-width: 0; }
.row__name { display: block; font-size: var(--text-sm); font-weight: var(--weight-medium); }
.row__nums { display: block; margin-top: var(--space-1); font-size: var(--text-xs); color: var(--color-text-tertiary); font-variant-numeric: tabular-nums; }
.row__diff { font-size: var(--text-lg); font-weight: var(--weight-semibold); font-variant-numeric: tabular-nums; }
.row__diff--bad { color: var(--color-feedback-error-text); }

.tag {
  display: inline-block; padding: 2px 8px; font-size: var(--text-xs);
  border-radius: var(--radius-badge);
  background: var(--color-surface-sunken);
  border: 1px solid var(--color-border-default);
  color: var(--color-text-secondary);
}
.tag--ok { background: var(--color-feedback-success-bg); border-color: var(--color-feedback-success-border); color: var(--color-feedback-success-text); }
.tag--warn { background: var(--color-feedback-warning-bg); border-color: var(--color-feedback-warning-border); color: var(--color-feedback-warning-text); }
.tag--bad { background: var(--color-feedback-error-bg); border-color: var(--color-feedback-error-border); color: var(--color-feedback-error-text); }

.empty { padding: 64px 16px; text-align: center; font-size: var(--text-sm); color: var(--color-text-secondary); }

/* 我的店 */
.panel {
  padding: var(--space-4);
  margin-bottom: var(--space-3);
  background: var(--color-surface-card);
  border: 1px solid var(--color-border-default);
  border-radius: var(--radius-card);
}
.panel__h { display: block; font-size: var(--text-base); font-weight: var(--weight-semibold); margin-bottom: var(--space-2); }
.panel__p { display: block; font-size: var(--text-sm); color: var(--color-text-secondary); }
.kv { display: flex; justify-content: space-between; padding: var(--space-2) 0; border-top: 1px solid var(--color-border-default); font-size: var(--text-sm); }
.kv:first-of-type { border-top: none; }
.kv__k { color: var(--color-text-tertiary); }
.kv__v { font-variant-numeric: tabular-nums; }

.banner--err {
  background: var(--color-feedback-error-bg);
  border-color: var(--color-feedback-error-border);
}
.banner--err .banner__t,
.banner--err .banner__d { color: var(--color-feedback-error-text); }
